[Desktop Entry]
Type=Application
Name=Activity
GenericName=Task Manager
Comment=Processes, live performance graphs, startup items and services
Exec=nyx-activity
Icon=io.github.design_nexus.nyx.Activity
Terminal=false
StartupNotify=true
StartupWMClass=io.github.design_nexus.nyx.Activity
Categories=System;Monitor;GTK;
Keywords=activity;task;manager;process;kill;cpu;memory;ram;gpu;disk;network;startup;autostart;services;systemd;monitor;
Actions=processes;performance;startup;

[Desktop Action processes]
Name=Processes
Exec=nyx-activity --section processes

[Desktop Action performance]
Name=Performance
Exec=nyx-activity --section cpu

[Desktop Action startup]
Name=Startup Items
Exec=nyx-activity --section startup
